CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-WROOM-1-N16R8: 16 MB flash, 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 1.5 MB app slot: HTTPS upload (TLS + CA certificate list) makes the app > 1 MB
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# Keep booting if PSRAM is not found: the [BOOT] line reports it and the microphone uses a
# short internal-RAM buffer, instead of an abort/reset loop before app_main.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Bigger main task stack (the capture loop and Wi-Fi run in app_main)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
